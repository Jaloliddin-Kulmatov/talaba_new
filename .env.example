# ── Frontend (Vercel → Project → Settings → Environment Variables) ─────────────
# Pick ONE way to reach the Flask backend:
#
#  A) Same-origin proxy (recommended; no CORS, works on preview URLs): set only BACKEND_URL.
#     The site calls /api/... and Next.js forwards it to the backend. Leave NEXT_PUBLIC_API_URL unset.
BACKEND_URL=https://your-backend.onrender.com
#
#  B) Direct calls: set NEXT_PUBLIC_API_URL (include /api). The backend's FRONTEND_URL must then list this site's origin.
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Canonical public origin (sitemap, robots, Open Graph). Defaults to https://talaba.uz
# NEXT_PUBLIC_SITE_URL=https://talaba.uz

# Optional: Google sign-in (the same OAuth client must allow this site's origin)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# NEXT_PUBLIC_* values are baked in at build time: change one → redeploy.
