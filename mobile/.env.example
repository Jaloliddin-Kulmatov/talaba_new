# Backend API base (include /api). Production builds MUST set this.
# In development the app finds your computer automatically (http://<your-LAN-IP>:5001/api).
EXPO_PUBLIC_API_URL=https://your-backend.example.com/api

# Public website, used for guide links and sharing
EXPO_PUBLIC_SITE_URL=https://talaba.uz

# Needed for phone push notifications (from `eas init`)
# EXPO_PUBLIC_EAS_PROJECT_ID=
